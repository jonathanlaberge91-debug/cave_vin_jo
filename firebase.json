{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "//": "Par defaut : pas de cache. index.html et flutter_bootstrap.js sont petits et portent le numero de version.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "//": "Polices et moteur graphique : ne changent quasi jamais -> cache 7 jours.",
        "source": "**/*.@(ttf|otf|woff|woff2|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "//": "UNIQUEMENT les fichiers dont le nom contient une empreinte (tool/fingerprint_web.js) : main.<empreinte>.dart.js et splash-logo.<empreinte>.jpg. Leur nom change a chaque build, donc un cache d'un an ne peut pas servir une vieille version. Le motif '?*' impose au moins un caractere entre les points : un 'main.dart.js' non empreinte ne matche PAS.",
        "source": "/@(main.?*.dart.js|splash-logo.?*.jpg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "cave-vin-jo",
          "appId": "1:130615476237:android:19d712ac3166188625d544",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "cave-vin-jo",
          "configurations": {
            "android": "1:130615476237:android:19d712ac3166188625d544",
            "ios": "1:130615476237:ios:ab4cb0a8fbcf75bd25d544",
            "web": "1:130615476237:web:babd060e5ccb4ea925d544",
            "windows": "1:130615476237:web:f596352171fde86325d544"
          }
        }
      }
    }
  }
}
