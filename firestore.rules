rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Toutes les opérations exigent une session authentifiée (anonyme ok).
    // Bloque les scrapers / le trafic non-authentifié.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
